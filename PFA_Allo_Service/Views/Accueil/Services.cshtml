
@{
    ViewData["Title"] = "Services";
    Layout = "~/Views/Shared/Accueil_Layout.cshtml";
}
@if (ViewData["Services"] is IEnumerable<Service> services)
{
    <div class="container">
        @{
            bool addRow = true;
            List<Service> serviceList = services.ToList();

            foreach (var service in serviceList)
            {
                if (addRow)
                {
                    @:<div class="mb-5"> </div> 
                    @:    <div class="row row-cols-1 row-cols-md-3 g-4">              
                    addRow = false;
                }

                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img src="~/images/@service.Photo" class="card-img-top service-image" alt="Service Image">
                        <div class="card-body">
                            <h5 class="card-title">@service.Libelle</h5>
                            <p class="card-text">@service.Description</p>
                            <div class="btn-group">
                                @* <button type="button" class="btn btn-sm btn-success"><i class="fas fa-comments"></i> Message</button>*@
                                 <a href="@Url.Action("Metiers", "Service", new { serviceId = service.ServiceId })" class="btn btn-primary">Liste de Metiers</a>
                            </div>
                        </div>
                    </div>
                </div>

                if ((serviceList.IndexOf(service) + 1) % 3 == 0 || serviceList.IndexOf(service) == serviceList.Count() - 1)
                {
                    addRow = true;
                    @:</div>
                    @:<div class="mb-5"> </div> 
                }
            }
        }

        @if (serviceList.Count() % 3 != 0)
        {
            @:</div>
        }
    </div>
}
else
{
    <p>No services found.</p>
}
<style>
    .service-image {
        height: 200px; /* Spécifiez la hauteur souhaitée */
        object-fit: cover; /* Assure que l'image couvre la zone définie par la hauteur */
    }
</style>