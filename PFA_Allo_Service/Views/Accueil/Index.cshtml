                        <p class="counter">1545 </p>
                        <h3>Récompenses Gagnées</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- //caractéristiques-->

<section class="w3l-about-ab w3l-content-8" id="about">
