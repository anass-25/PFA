@{
    ViewData["Title"] = "Offre";
    Layout = "~/Views/Shared/Accueil_Layout.cshtml";
}

@if (ViewData["Offres"] is IEnumerable<Offre> offres)
{
    <div class="container">
        @{
            bool addRow = true;
            List<Offre> offreList = offres.ToList();
            DateTime currentDate = DateTime.Now;

            foreach (var offre in offreList)
            {
                if (addRow)
                {
                    @:<div class="mb-5"> </div> 
                    @:    <div class="row row-cols-1 row-cols-md-3 g-4">              
                    addRow = false;
                }

                <div class="col">
                    @{
                        bool isExpired = currentDate > offre.Date_Fin;
                        string cardClass = isExpired ? "card h-100 shadow-sm expired-offer" : "card h-100 shadow-sm";
                    }
                    <div class="@cardClass">
                        <img src="~/images/@offre.Photo" class="card-img-top offre-image" alt="Offre Image">
                        <div class="card-body">
                            <h5 class="card-title">@offre.Titre</h5>
                            <p class="card-text">@offre.Description</p>
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item"><strong>Prix:</strong> @offre.Prix</li>
                                <li class="list-group-item"><strong>Date de Début:</strong> @offre.Date_Debut.ToShortDateString()</li>
                                <li class="list-group-item"><strong>Date de Fin:</strong> @offre.Date_Fin.ToShortDateString()</li>
                            </ul>
                            <div class="btn-group">
                                            <a href="@Url.Action("FournisseurOffres", "Accueil", new { fournisseurId = offre.FournisseurId })" class="btn btn-sm btn-primary"><i class="fas fa-eye"></i> Voir Profile</a>
                            </div>
                        </div>
                    </div>
                </div>

                if ((offreList.IndexOf(offre) + 1) % 3 == 0 || offreList.IndexOf(offre) == offreList.Count() - 1)
                {
                    addRow = true;
                    @:</div>
                    @:<div class="mb-5"> </div> 
                }
            }
        }

        @if (offreList.Count() % 3 != 0)
        {
            @:</div>
        }
    </div>
}
else
{
    <p>No offers found.</p>
}

<style>
    .offre-image {
        height: 200px; /* Spécifiez la hauteur souhaitée */
        object-fit: cover; /* Assure que l'image couvre la zone définie par la hauteur */
    }

    .expired-offer {
        filter: grayscale(100%); /* Applique le filtre de désaturation pour griser l'image */
        pointer-events: none; /* Désactive les événements de souris pour l'offre expirée */
    }
</style>