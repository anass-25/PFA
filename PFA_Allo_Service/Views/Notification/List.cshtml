@model List<PFA_Allo_Service.Models.Notification>

@{
    ViewData["Title"] = "List of Notifications";
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}

@section styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}

<div class="right_col" role="main">
    <div class="">
        <div class="col-md-12 col-sm-12 ">
            <div class="x_panel">
                <div class="x_title">
                    <h2>List of Notifications</h2>
                    <ul class="nav navbar-right panel_toolbox">
                        <li><a class="collapse-link"><i class="fa fa-chevron-up"></i></a></li>
                        <li class="dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false"><i class="fa fa-wrench"></i></a>
                            <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                <a class="dropdown-item" href="#">Settings 1</a>
                                <a class="dropdown-item" href="#">Settings 2</a>
                            </div>
                        </li>
                        <li><a class="close-link"><i class="fa fa-close"></i></a></li>
                    </ul>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">
                    <div id="alert-message" class="alert alert-danger" style="display:none;"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="card-box table-responsive">
                                <a class="btn btn-warning" asp-controller="Notification" asp-action="Add"><i class="fa-sharp fa-solid fa-plus"></i></a>
                                @if (Model.Count > 0)
                                {
                                    <table id="datatable" class="table table-striped table-bordered" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>Titre</th>
                                                <th>Contenu</th>
                                                <th>User Type</th>
                                                <th>Date</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var notification in Model)
                                            {
                                                <tr>
                                                    <td>@notification.Titre</td>
                                                    <td>@notification.Contenu</td>
                                                    <td>@notification.UserType</td>
                                                    <td>@notification.Date_Notif.ToShortDateString()</td>
                                                    <td>
                                                        <button class="btn btn-danger" onclick="deleteNotification(@notification.NotificationId)">
                                                            <i class="fas fa-trash-alt" title="Supprimer"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <p>No notifications found.</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        function deleteNotification(id) {
            if (confirm('Are you sure you want to delete this notification?')) {
                $.ajax({
                    url: '@Url.Action("Delete", "Notification")/' + id,
                    type: 'DELETE',
                    success: function (response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            $('#alert-message').text(response.message).show();
                            setTimeout(function () {
                                $('#alert-message').hide();
                            }, 5000);
                        }
                    },
                    error: function () {
                        $('#alert-message').text('Error deleting the notification.').show();
                        setTimeout(function () {
                            $('#alert-message').hide();
                        }, 5000);
                    }
                });
            }
        }
    </script>
}
