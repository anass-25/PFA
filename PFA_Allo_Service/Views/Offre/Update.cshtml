@{
    ViewData["Title"] = "Modifier Offre";
    Layout = "~/Views/Shared/AccueilFournisseur_Layout.cshtml";
}
@section styles {
    <!-- bootstrap-wysiwyg -->
    <link href="~/Admin/vendors/google-code-prettify/bin/prettify.min.css" rel="stylesheet">
    <!-- Select2 -->
    <link href="~/Admin/vendors/select2/dist/css/select2.min.css" rel="stylesheet">
    <!-- Switchery -->
    <link href="~/Admin/vendors/switchery/dist/switchery.min.css" rel="stylesheet">
    <!-- starrr -->
    <link href="~/Admin/vendors/starrr/dist/starrr.css" rel="stylesheet">
}
@model OffreVM
<div class="inner-banner">
</div>
<section class="w3l-breadcrumb">
    <div class="container">
        <ul class="breadcrumbs-custom-path">
            <li><a href="@Url.Action("Index","Fournisseur")">Accueil</a></li>
            <li class="active"><span class="fa fa-arrow-right mx-2" aria-hidden="true"></span> Modifier l'Offre</li>
        </ul>
    </div>
</section>
<section class="w3l-contact-1 py-5" id="modifier-offre">
    <div class="contacts-9 py-lg-5 py-md-4">
        <div class="container">
            <div class="contactct-fm map-content-9">
                <div class="header-title text-center">
                    <h6 class="title-subhny"><span>Modifier l'Offre</span></h6>
                    <h3 class="title-w3l mb-2">
                        Mettez à Jour Votre
                        <span class="span-bold"> Offre</span>
                    </h3>
                </div>
                <form id="demo-form2" data-parsley-validate class="pt-lg-4" method="post" enctype="multipart/form-data" asp-action="Update" asp-controller="Offre">
                    <div class="twice-two">
                        <input type="text" class="form-control" name="Titre" placeholder="Titre" asp-for="Titre" required="">
                        <span asp-validation-for="Titre" class="text-danger"></span>

                        <input class="form-control" name="Prix" placeholder="Prix" asp-for="Prix" required="">
                        <span asp-validation-for="Prix" class="text-danger"></span>
                    </div>

                    <input type="file" class="form-control" name="MonImage" placeholder="Photo" asp-for="Photo" accept="Photo/*">
                    <span asp-validation-for="Photo" class="text-danger"></span>
                    <br />
                    <textarea name="Description" class="form-control" placeholder="Description" asp-for="Description" rows="5" required=""></textarea>
                    <br />
                    <div class="twice-two">
                        <input class="form-control" type="date" name="Date_Debut" placeholder="Date de Début" asp-for="Date_Debut" required="">
                        <span asp-validation-for="Date_Debut" class="text-danger"></span>

                        <input class="form-control" type="date" name="Date_Fin" placeholder="Date de Fin" asp-for="Date_Fin" required="">
                        <span asp-validation-for="Date_Fin" class="text-danger"></span>
                    </div>

                    <div class="text-lg-center">
                        <button type="submit" class="btn btn-primary btn-style mt-lg-5 mt-4">Mettre à Jour</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
@section scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <!-- bootstrap-wysiwyg -->
    <script src="~/Admin/vendors/bootstrap-wysiwyg/js/bootstrap-wysiwyg.min.js"></script>
    <script src="~/Admin/vendors/jquery.hotkeys/jquery.hotkeys.js"></script>
    <script src="~/Admin/vendors/google-code-prettify/src/prettify.js"></script>
    <!-- jQuery Tags Input -->
    <script src="~/Admin/vendors/jquery.tagsinput/src/jquery.tagsinput.js"></script>
    <!-- Switchery -->
    <script src="~/Admin/vendors/switchery/dist/switchery.min.js"></script>
    <!-- Select2 -->
    <script src="~/Admin/vendors/select2/dist/js/select2.full.min.js"></script>
    <!-- Parsley -->
    <script src="~/Admin/vendors/parsleyjs/dist/parsley.min.js"></script>
    <!-- Autosize -->
    <script src="~/Admin/vendors/autosize/dist/autosize.min.js"></script>
    <!-- jQuery autocomplete -->
    <script src="~/Admin/vendors/devbridge-autocomplete/dist/jquery.autocomplete.min.js"></script>
    <!-- starrr -->
    <script src="~/Admin/vendors/starrr/dist/starrr.js"></script>
}
