            <!-- Pied de page -->
            <footer>
                <div class="pull-right">
                    Gentelella - Modèle d'administration Bootstrap par <a href="https://colorlib.com">Colorlib</a>
                </div>
                <div class="clearfix"></div>
            </footer>
            <!-- /Pied de page -->
        </div>
    </div>
    <script src="https://kit.fontawesome.com/321fe55b1c.js" crossorigin="anonymous"></script>

