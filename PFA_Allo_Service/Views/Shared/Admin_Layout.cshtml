                                            <span>
                                                <span>John Smith</span>
                                                <span class="time">Il y a 3 minutes</span>
                                            </span>
                                            <span class="message">
                                                Les festivals de cinéma étaient autrefois des moments cruciaux pour les réalisateurs. C'était là où...
                                            </span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="dropdown-item">
                                            <span class="image"><img src="~/Admin/images/img.jpg" alt="Image de profil" /></span>
                                            <span>
                                                <span>John Smith</span>
                                                <span class="time">Il y a 3 minutes</span>
                                            </span>
                                            <span class="message">
                                                Les festivals de cinéma étaient autrefois des moments cruciaux pour les réalisateurs. C'était là où...
                                            </span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="dropdown-item">
                                            <span class="image"><img src="~/Admin/images/img.jpg" alt="Image de profil" /></span>
                                            <span>
                                                <span>John Smith</span>
                                                <span class="time">Il y a 3 minutes</span>
                                            </span>
                                            <span class="message">
                                                Les festivals de cinéma étaient autrefois des moments cruciaux pour les réalisateurs. C'était là où...
                                            </span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <div class="text-center">
                                            <a class="dropdown-item">
                                                <strong>Voir toutes les alertes</strong>
                                                <i class="fa fa-angle-right"></i>
                                            </a>
                                        </div>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>

            <!-- Contenu de la page -->
            @RenderBody()
