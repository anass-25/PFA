@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <!-- Métadonnées, titre, CSS, favicons, etc. -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="~/Admin/images/favicon.ico" type="image/ico" />

    <title>Gentelella Alela!</title>
    <!-- Bootstrap -->
    <link href="~/Admin/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="~/Admin/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet">
    <!-- NProgress -->
    <link href="~/Admin/vendors/nprogress/nprogress.css" rel="stylesheet">
    <!-- iCheck -->
    <link href="~/Admin/vendors/iCheck/skins/flat/green.css" rel="stylesheet">

    <!-- Barre de progression Bootstrap -->
    <link href="~/Admin/vendors/bootstrap-progressbar/css/bootstrap-progressbar-3.3.4.min.css" rel="stylesheet">
    <!-- JQVMap -->
    <link href="~/Admin/vendors/jqvmap/dist/jqvmap.min.css" rel="stylesheet" />
    <!-- Sélecteur de plage de dates Bootstrap -->
    <link href="~/Admin/vendors/bootstrap-daterangepicker/daterangepicker.css" rel="stylesheet">

    <!-- Style personnalisé -->
    <link href="~/Admin/build/css/custom.min.css" rel="stylesheet">
    @RenderSection("styles", required: false)
</head>

<body class="nav-md">
    <div class="container body">

        <div class="main_container">
            <div class="col-md-3 left_col">

                <div class="left_col scroll-view">
                    <div class="navbar nav_title" style="border: 0;">
                        <a href="@Url.Action("Index","Admin")" class="site_title"> <span>Allo Service</span></a>
                    </div>

                    <div class="clearfix"></div>

                    <!-- Informations rapides sur le profil -->
                    <div class="profile clearfix">
                        <div class="profile_pic">
                            <img src="~/Admin/images/img.jpg" alt="..." class="img-circle profile_img">
                        </div>
                        <div class="profile_info">
                            <span>Bonjour,</span>
                            <h2>@Context.Session.GetString("Email")</h2>
                        </div>
                    </div>
