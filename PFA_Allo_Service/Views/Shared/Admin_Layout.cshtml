                                        <li><a href="@Url.Action("Gestion_Metier_Fournisseur","Admin")">Gestion des Métiers et des Fournisseurs</a></li>
                                        <li><a href="@Url.Action("Index","Service")">Gestion des Services</a></li>
                                        <li><a href="@Url.Action("Index","Abonnement")">Gestion des Abonnements</a></li>
                                        <li><a href="@Url.Action("Index","Paiement")">Gestion des Paiements</a></li>
                                        <li><a href="@Url.Action("Index","Reclamation")">Gestion des Réclamations</a></li>
                                        <li><a href="@Url.Action("List","Notification")">Gestion des Notifications</a></li>
                                    </ul>
                                </li>
                            </ul>
                        </div>

                    </div>
                    <!-- /Menu latéral -->
                    <!-- Boutons de pied de page du menu -->
                    <div class="sidebar-footer hidden-small">
                        <a data-toggle="tooltip" data-placement="top" title="Paramètres">
                            <span class="glyphicon glyphicon-cog" aria-hidden="true"></span>
                        </a>
                        <a data-toggle="tooltip" data-placement="top" title="Déconnexion" href="@Url.Action("Login","Users")">
                            <span class="glyphicon glyphicon-off" aria-hidden="true"></span>
                        </a>
                    </div>
                    <!-- /Boutons de pied de page du menu -->
                </div>
            </div>
            <!-- Navigation supérieure -->
            <div class="top_nav">
                <div class="nav_menu">
                    <div class="nav toggle">
                        <a id="menu_toggle"><i class="fa fa-bars"></i></a>
                    </div>
                    <nav class="nav navbar-nav">
