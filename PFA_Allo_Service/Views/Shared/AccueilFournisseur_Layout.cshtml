    <style>
        .navbar-right {
            margin-right: 15px; /* Marge à droite pour aligner le contenu */
        }
            .navbar-right .nav-item {
                position: relative;
            }
            .navbar-right .dropdown-menu {
                position: absolute;
                top: 100%; /* Positionner le menu déroulant en dessous du lien */
                right: 0; /* Aligner le menu déroulant à droite */
                z-index: 1000; /* Assurer que le menu déroulant est au-dessus de tout */
                min-width: 200px; /* Largeur minimale du menu déroulant */
                background-color: #fff; /* Couleur de fond du menu déroulant */
                box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); /* Ombre légère */
                border-radius: 4px; /* Coins arrondis */
                display: none; /* Caché par défaut */
            }
        .user-profile img {
            width: 50px; /* Largeur de l'image */
            height: 50px; /* Hauteur de l'image */
            border-radius: 50%; /* Pour créer une forme circulaire */
        }
        .navbar-right .dropdown-menu.show {
            display: block; /* Afficher lorsque le lien est survolé */
        }
        .navbar-right .dropdown-menu a {
            display: block;
            padding: 8px 15px;
            color: #333;
            text-decoration: none;
            transition: all 0.3s ease;
        }
            .navbar-right .dropdown-menu a:hover {
                background-color: #f5f5f5; /* Couleur de fond au survol */
            }
        header.nav-fixed {
            padding: 0px;
            background-color: var(--bg-color);
            height: 80px;
            border-bottom: none;
            box-shadow: 0 25px 98px 0 rgba(0, 0, 0, 0.03);
        }
        .center-block {
            margin-top: 5px;
            box-sizing: border-box;
        }
        .w3l-main-slider .banner-view {
            background: url(../images/imageAccueil.jpg);
            -ms-background-size: cover;
            background-size: cover;
            z-index: 0;
            position: relative;
            display: grid;
            align-items: center;
            min-height: 650px;
            background-size: cover;
        }
        .mb-4, .my-4 {
            margin-bottom: 1.5rem !important;
        }

        .card {
            position: relative;
            display: flex;
            flex-direction: column;
            min-width: 0;
            word-wrap: break-word;
            background-color: #fff;
            background-clip: border-box;
            border: 1px solid rgba(0, 0, 0, 0.125);
            border-radius: 0.25rem;
        }

        .card-header {
            background-color: #FFA500;
        }
        
        .col-md-3 {
            flex: 0 0 25%;
            max-width: 25%;
        }

        .fournisseur-photo {
            height: 150px;
            width: 150px;
            object-fit: cover;
            border-radius: 50%;
            margin-bottom: 10px;
        }

        .inner-banner {
            min-height: 260px;
            background: url(../images/imageAccueil.jpg);
            -ms-background-size: cover;
            background-size: cover;
            z-index: 0;
            position: relative;
        }
    </style>
