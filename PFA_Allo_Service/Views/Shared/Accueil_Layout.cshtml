                            <a href="#" class="dropdown-item text-center" id="viewAllNotifications">View all notifications</a>
                        </div>
                    </li>
                }
                <!-- toggle switch for light and dark theme -->
                <div>
                    <nav>
                        <div>
                            <label class="theme-switch" for="checkbox">
