    <script src="~/Accueil/assets/js/jquery-1.9.1.min.js"></script>
    <script src="~/Accueil/assets/js/easyResponsiveTabs.js"></script>
    <script src="~/Accueil/assets/js/owl.carousel.js"></script>
    <script src="~/Accueil/assets/js/jquery.magnific-popup.min.js"></script>
