<!doctype html>
@inject IHttpContextAccessor HttpContextAccessor
<html lang="fr">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Allo Service - Accueil</title>
    <!-- Template CSS -->
    <link rel="stylesheet" href="~/Accueil/assets/css/style-starter.css">
    <style>
        .navbar-right {
            margin-right: 15px; /* Marge à droite pour aligner le contenu */
        }

            .navbar-right .nav-item {
                position: relative;
            }

            .navbar-right .dropdown-menu {
                position: absolute;
                top: 100%; /* Positionner le menu déroulant en dessous du lien */
                right: 0; /* Aligner le menu déroulant à droite */
                z-index: 1000; /* Assurer que le menu déroulant est au-dessus de tout */
                min-width: 200px; /* Largeur minimale du menu déroulant augmentée */
                background-color: #fff; /* Couleur de fond du menu déroulant */
                box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); /* Ombre légère */
                border-radius: 4px; /* Coins arrondis */
                display: none; /* Caché par défaut */
            }

        .user-profile img {
            width: 50px; /* Largeur de l'image */
            height: 50px; /* Hauteur de l'image */
            border-radius: 50%; /* Pour créer une forme circulaire */
        }

        .navbar-right .dropdown-menu.show {
            display: block; /* Afficher lorsque le lien est survolé */
        }

        .navbar-right .dropdown-menu a {
            display: block;
            padding: 8px 15px;
            color: #333;
            text-decoration: none;
            transition: all 0.3s ease;
        }

            .navbar-right .dropdown-menu a:hover {
                background-color: #f5f5f5; /* Couleur de fond au survol */
            }

        header.nav-fixed {
            padding: 0px;
            background-color: var(--bg-color);
            height: 80px;
            border-bottom: none;
            box-shadow: 0 25px 98px 0 rgba(0, 0, 0, 0.03);
        }

        .w3l-main-slider .banner-view {
            background: url(../images/imageAccueil.jpg);
            -ms-background-size: cover;
            background-size: cover;
            z-index: 0;
            position: relative;
            display: grid;
            align-items: center;
            min-height: 650px;
            background-size: cover;
        }

        .grid-image {
            height: 300px; /* Set your desired height */
            width: 100%; /* Ensures the image fills the container's width */
            object-fit: cover; /* Ensures the image covers the area, cropping if necessary */
        }

        .inner-banner {
            min-height: 260px;
            background: url(../images/imageAccueil.jpg);
            -ms-background-size: cover;
            background-size: cover;
            z-index: 0;
            position: relative;
        }

        .header-select {
            background-color: #fff;
            border: 1px solid #fff;
            border-radius: 1px;
            padding: 1px 11px;
            font-size: 14px;
            color: #333;
            transition: auto 0.3s ease;
        }

        select {
            margin: -6px;
            font-family: inherit;
            font-size: inherit;
            line-height: inherit;
        }
            .header-select:focus {
                border-color: #007bff; /* Blue border on focus */
                outline: none; /* Remove default outline */
            }

            .header-select option {
                padding: 8px 15px; /* Padding inside options */
                color: #333; /* Text color for options */
                background-color: #fff; /* White background for options */
            }

                .header-select option:hover {
                    background-color: #f5f5f5; /* Light grey background on hover */
                }

        .custom-select {
            display: inline-block;
            width: 100%;
            height: calc(1.5em + 0.75rem + 2px);
            padding: -0.625rem 1.75rem 0.375rem 0.75rem;
            font-size: 1rem;
            /* font-weight: 700; */
            line-height: 1.8;
            color: #495057;
            vertical-align: middle;
            background: #fff url(data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='4' height='5' viewBox='0 0 4 5'%3e%3cpath fill='%23343a40' d='M2 0L0 2h4zm0 5L0 3h4z'/%3e%3c/svg%3e) no-repeat right 0.75rem center / 8px 10px;
            border: 0.5px solid #e55208;
            border-radius: 0.25rem;
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
        }
    </style>

    <script src="~/Accueil/assets/js/bootstrap.min.js"></script>
    <script src="~/Accueil/assets/js/Formulaire/bootstrap.bundle.min.js"></script>
    <script src="~/Accueil/assets/js/Formulaire/jquery.min.js"></script>

    @RenderSection("styles", required: false)
</head>
