@model List<Metier>

@{
    ViewData["Title"] = "Liste des Métiers";
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}


@section styles {
    <!-- Bootstrap -->
    <link href="https://cdn.datatables.net/1.10.20/css/jquery.dataTables.min.css" rel="stylesheet">
    <!-- Datatables -->
    <link href="~/Admin/vendors/datatables.net-bs/css/dataTables.bootstrap.min.css" rel="stylesheet">
    <link href="~/Admin/vendors/datatables.net-buttons-bs/css/buttons.bootstrap.min.css" rel="stylesheet">
    <link href="~/Admin/vendors/datatables.net-fixedheader-bs/css/fixedHeader.bootstrap.min.css" rel="stylesheet">
    <link href="~/Admin/vendors/datatables.net-responsive-bs/css/responsive.bootstrap.min.css" rel="stylesheet">
    <link href="~/Admin/vendors/datatables.net-scroller-bs/css/scroller.bootstrap.min.css" rel="stylesheet">
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="right_col" role="main">
    <div class="">
        <div class="col-md-12 col-sm-12 ">
            <div class="x_panel">
                <div class="x_title">
                    <h2>Liste des Métiers <small>Gestion des métiers</small></h2>
                    <ul class="nav navbar-right panel_toolbox">
                        <li>
                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                        </li>
                        <li class="dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false"><i class="fa fa-wrench"></i></a>
                            <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                <a class="dropdown-item" href="#">Settings 1</a>
                                <a class="dropdown-item" href="#">Settings 2</a>
                            </div>
                        </li>
                        <li>
                            <a class="close-link"><i class="fa fa-close"></i></a>
                        </li>
                    </ul>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="card-box table-responsive">
                                <div class="text-center mb-4">
                                    <a class="btn btn-primary" asp-action="Add">Ajouter un Métier</a>
                                </div>
                                <table id="datatable" class="table table-striped table-bordered" style="width:100%">
                                    <thead class="thead-dark">
                                        <tr>
                                            <th>Catégorie</th>
                                            <th>Description</th>
                                            <th>Photo</th>
                                            <th>Service</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr class="table-row" data-id="@item.MetierId">
                                                <td>@item.Categorie</td>
                                                <td>@item.Description</td>
                                                <td>
                                                    <img style="width:100px;height:100px" src="~/images/@item.Photo" alt="Photo de @item.Categorie" />
                                                </td>
                                                <td>@item.service</td>
                                                <td>
                                                    <a class="btn btn-warning" asp-controller="Metier" asp-action="Update" asp-route-id="@item.MetierId"><i class="fas fa-edit" title="Modifier"></i> Modifier</a>
                                                    <a onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce métier ?')" class="btn btn-danger" asp-controller="Metier" asp-action="Delete" asp-route-id="@item.MetierId"><i class="fas fa-trash-alt" title="Supprimer"></i> Supprimer</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <!-- Datatables -->
    <script src="~/Admin/vendors/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/Admin/vendors/datatables.net-bs/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Admin/vendors/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/Admin/vendors/datatables.net-buttons-bs/js/buttons.bootstrap.min.js"></script>
    <script src="~/Admin/vendors/datatables.net-buttons/js/buttons.flash.min.js"></script>
    <script src="~/Admin/vendors/datatables.net-buttons/js/buttons.html5.min.js"></script>
    <script src="~/Admin/vendors/datatables.net-buttons/js/buttons.print.min.js"></script>
    <script src="~/Admin/vendors/datatables.net-fixedheader/js/dataTables.fixedHeader.min.js"></script>
    <script src="~/Admin/vendors/datatables.net-keytable/js/dataTables.keyTable.min.js"></script>
    <script src="~/Admin/vendors/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/Admin/vendors/datatables.net-responsive-bs/js/responsive.bootstrap.js"></script>
    <script src="~/Admin/vendors/datatables.net-scroller/js/dataTables.scroller.min.js"></script>
    <script src="~/Admin/vendors/jszip/dist/jszip.min.js"></script>
    <script src="~/Admin/vendors/pdfmake/build/pdfmake.min.js"></script>
    <script src="~/Admin/vendors/pdfmake/build/vfs_fonts.js"></script>
}