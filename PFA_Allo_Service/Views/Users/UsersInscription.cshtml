@model InscriptionVM
@{
    ViewData["Title"] = "UsersInscription";
    Layout = "~/Views/Shared/LoginAccueil_Layout.cshtml";
}
<main>
    <div class="container">

        <section class="section register min-vh-100 d-flex flex-column align-items-center justify-content-center py-4">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-6 col-md-8 d-flex flex-column align-items-center justify-content-center">

                        <div class="d-flex justify-content-center py-4">
                            <a href="@Url.Action("Login","Users")" class="logo d-flex align-items-center w-auto">
                                <img src="~/Accueil/assets/images/allo-service.png" alt="" class="logo">
                                
                            </a>
                        </div>

                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="pt-4 pb-2">
                                    <h5 class="card-title text-center pb-0 fs-4">Créer un compte</h5>
                                    <p class="text-center small">Entrer vos donner personnelle pour créer votre compte</p>
                                </div>

                                <form asp-action="UsersInscription" method="post" class="row g-3 needs-validation" novalidate>
                                    <div class="col-md-6">
                                        <label asp-for="Nom" class="form-label"></label>
                                        <input asp-for="Nom" class="form-control">
                                        <span asp-validation-for="Nom" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Prenom" class="control-label"></label>
                                        <input asp-for="Prenom" class="form-control" />
                                        <span asp-validation-for="Prenom" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="CIN" class="control-label"></label>
                                        <input asp-for="CIN" class="form-control" />
                                        <span asp-validation-for="CIN" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Telephone" class="control-label"></label>
                                        <input asp-for="Telephone" class="form-control" />
                                        <span asp-validation-for="Telephone" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Email" class="control-label"></label>
                                        <input asp-for="Email" class="form-control" />
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Role" class="control-label"></label>
                                        <select asp-for="Role" class="form-control" id="chooseRole" onchange="showelements()">
                                            <option value="">Sélectionnez un rôle</option>
                                            <option value="Client">Client</option>
                                            <option value="Fournisseur">Fournisseur</option>
                                        </select>
                                        <span asp-validation-for="Role" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6 forClient" style="display:none">
                                        <label asp-for="Localisation" class="control-label"></label>
                                        <input asp-for="Localisation" class="form-control" />
                                        <span asp-validation-for="Localisation" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6 forFournisseur" style="display:none">
                                        <label asp-for="Disponibiliter" class="control-label">Disponibilité :</label>
                                        <select asp-for="Disponibiliter" class="form-control" id="chooseRole" onchange="showelements()">
                                            <option value="Disponible">Disponible</option>
                                            <option value="Non Diponible">Non Diponible</option>
                                        </select>
                                        <span asp-validation-for="Disponibiliter" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6 forFournisseur" style="display:none">
                                        <label asp-for="MetierId" class="control-label">Métier :</label>
                                        <select asp-for="MetierId" class="form-control">
                                            <option value="">Sélectionnez un métier</option>
                                            @foreach (var metier in ViewBag.MetierList)
                                            {
                                                <option value="@metier.Value">@metier.Text</option>
                                            }
                                        </select>
                                        <span asp-validation-for="MetierId" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="control-label">Mot de Passe</label>
                                        <input asp-for="Mot_de_Passe" class="form-control" />
                                        <span asp-validation-for="Mot_de_Passe" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="control-label">Confirmer Mot de Passe</label>
                                        <input asp-for="Confirm_MDP" type="password" class="form-control" />
                                        <span asp-validation-for="Confirm_MDP" class="text-danger"></span>
                                    </div>

@*                                     ---------------------*@
                                    <div class="col-12 d-flex justify-content-center">
                                        <input type="submit" name="submitType" value="S'inscrire" class="btn btn-primary btn-lg w-100" asp-action="UsersInscription" asp-controller="Users" />
                                    </div>
                                   @*  <div class="col-12 text-center mt-3">
                                        <p class="small">Already have an account? <a href="pages-login.html">Log in</a></p>
                                    </div> *@
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </div>
</main>

@section Scripts {
    <script>
        function showelements() {
            var role = document.getElementById("chooseRole").value;
            var forClient = document.getElementsByClassName("forClient");
            var forFournisseur = document.getElementsByClassName("forFournisseur");
            if (role == "Client") {
                for (var i = 0; i < forClient.length; i++) {
                    forClient[i].style.display = "block";
                }
                for (var i = 0; i < forFournisseur.length; i++) {
                    forFournisseur[i].style.display = "none";
                }
            } else if (role == "Fournisseur") {
                for (var i = 0; i < forClient.length; i++) {
                    forClient[i].style.display = "none";
                }
                for (var i = 0; i < forFournisseur.length; i++) {
                    forFournisseur[i].style.display = "block";
                }
            } else {
                for (var i = 0; i < forClient.length; i++) {
                    forClient[i].style.display = "none";
                }
                for (var i = 0; i < forFournisseur.length; i++) {
                    forFournisseur[i].style.display = "none";
                }
            }   
        }
    </script>
    <partial name="_ValidationScriptsPartial" />
}