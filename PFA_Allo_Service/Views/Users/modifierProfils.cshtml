@using Microsoft.EntityFrameworkCore.Metadata.Internal
@model modifierProfilsVm
@{
    // Replace with your logic to get the user type
    var userType = Context.Session.GetString("Role");

    if (userType == "Fournisseur")
    {
        ViewData["Title"] = "Modifier Profil";
        Layout = "~/Views/Shared/AccueilFournisseur_Layout.cshtml";
    }
    else if (userType == "Client")
    {
        ViewData["Title"] = "Modifier Profil";
        Layout = "~/Views/Shared/Accueil_Layout.cshtml";
    }
}

<main id="main" class="main">
    <section class="section profile">
        <div class="container">
            <div class="row">
                <div class="col-xl-4">
                    <div class="card">
                        <div class="card-body profile-card pt-4 d-flex flex-column align-items-center">
                            <div class="profile-img-container">
                                @if (ViewBag.UserType == "Fournisseur")
                                {
                                    <div class="form-group">
                                        @if (Model.photos != null)
                                        {
                                            <img class="profile-img" src="@Url.Content("~/images/" + Model.photos)" alt="Photo de profil" />
                                        }
                                        else
                                        {
                                            <img class="profile-img" src="@Url.Content("~/images/bg1.png")" alt="Photo de profil par défaut" />
                                        }
                                    </div>
                                }
                            </div>
                            <h2>@Model.Nom @Model.Prenom</h2>
                        </div>
                    </div>
                </div>

                <div class="col-xl-8">
                    <div class="card">
                        <div class="card-body pt-3">
                            <form enctype="multipart/form-data" asp-action="modifierProfils" method="post">
                                <div class="row mb-3">
                                    @if (ViewBag.UserType == "Fournisseur")
                                    {
                                        <div class="col-md-8 col-lg-9">
                                            @if (Model.photos != null)
                                            {
                                                <img class="profile-img" src="@Url.Content("~/images/" + Model.photos)" alt="Photo de profil" />
                                            }
                                            else
                                            {
                                                <img class="profile-img" src="@Url.Content("~/images/bg1.png")" alt="Photo de profil par défaut" />
                                            }
                                            <input type="file" accept="image/*" asp-for="Photo" value="@Model.Photo" class="form-control mt-3">
                                        </div>
                                    }
                                </div>
                                <div class="mb-3">
                                    <label for="Nom" class="form-label">Nom :</label>
                                    <input asp-for="Nom" class="form-control" value="@Model.Nom">
                                    <span asp-validation-for="Nom" class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label for="Prenom" class="form-label">Prénom :</label>
                                    <input asp-for="Prenom" class="form-control" value="@Model.Prenom">
                                    <span asp-validation-for="Prenom" class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label for="Email" class="form-label">Email :</label>
                                    <input asp-for="Email" class="form-control" value="@Model.Email">
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label for="CIN" class="form-label">CIN :</label>
                                    <input asp-for="CIN" class="form-control" value="@Model.CIN">
                                    <span asp-validation-for="CIN" class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label for="Telephone" class="form-label">Téléphone :</label>
                                    <input asp-for="Telephone" class="form-control" value="@Model.Telephone">
                                    <span asp-validation-for="Telephone" class="text-danger"></span>
                                </div>
                                <div class="text-center">
                                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
}

<style>
    .profile-img {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        object-fit: cover;
    }

    .profile-img-container {
        text-align: center;
    }

    .main {
        padding: 20px;
    }

    .pagetitle {
        margin-bottom: 20px;
    }

    .breadcrumb {
        background-color: transparent;
        padding: 0;
        margin-bottom: 0;
    }
</style>
