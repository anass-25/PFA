@model ChangePasswordVM
@{
    ViewData["Title"] = "Changer Mot de Passe";
    var userType = ViewData["UserType"] as string;
    if (userType == "Fournisseur")
    {
        Layout = "~/Views/Shared/AccueilFournisseur_Layout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/Accueil_Layout.cshtml";
    }
}
<!--/inner-page-->
<div class="inner-banner">
</div>
<section class="w3l-breadcrumb">
    <div class="container">
        <ul class="breadcrumbs-custom-path">
            <li><a href="@Url.Action("Index","Accueil")">Accueil</a></li>
            <li class="active"><span class="fa fa-arrow-right mx-2" aria-hidden="true"></span> Changer Mot de Passe</li>
        </ul>
    </div>
</section>
<!--//inner-page-->
<!-- Change Password -->
<section class="w3l-contact-1 py-5" id="change-password">
    <div class="contacts-9 py-lg-5 py-md-4">
        <div class="container">
            <div class="contactct-fm map-content-9">
                <div class="header-title text-center">
                    <h6 class="title-subhny"><span>Changer Mot de Passe</span></h6>
                    <h3 class="title-w3l mb-2">
                        Mettez à jour votre
                        <span class="span-bold"> mot de passe</span>
                    </h3>
                    <p class="mb-sm-5 mb-4">
                        Veuillez entrer votre mot de passe actuel ainsi que le nouveau mot de passe.
                    </p>
                </div>
                <form asp-action="ChangePassword" method="post" class="pt-lg-4">
                    <div class="twice-two">
                        <input type="password" class="form-control" id="CurrentPassword" name="CurrentPassword" asp-for="CurrentPassword" placeholder="Mot de passe actuel" required>
                        <input type="password" class="form-control" id="NewPassword" name="NewPassword" asp-for="NewPassword" placeholder="Nouveau mot de passe" required>
                    </div>
                    <input type="password" class="form-control" id="ConfirmPassword" name="ConfirmPassword" asp-for="ConfirmPassword" placeholder="Confirmer le mot de passe" required>
                    <div class="text-lg-center">
                        <button type="submit" class="btn btn-primary btn-style mt-lg-5 mt-4">Enregistrer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
<!-- /Change Password -->
