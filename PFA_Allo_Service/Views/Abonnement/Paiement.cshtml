@model PFA_Allo_Service.Models.Paiement

@{
    ViewData["Title"] = "Paiement";
    Layout = "~/Views/Shared/AccueilFournisseur_Layout.cshtml";
}

<h1>@ViewData["Title"]</h1>



<form asp-action="Paiement">
    <div class="form-group">
        <label asp-for="Montant" class="control-label"></label>
        <input asp-for="Montant" class="form-control" />
        <span asp-validation-for="Montant" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Carte_Paiement" class="control-label"></label>
        <input asp-for="Carte_Paiement" class="form-control" />
        <span asp-validation-for="Carte_Paiement" class="text-danger"></span>
    </div>
    <input type="hidden" asp-for="AbonnementId" />
    <div class="form-group">
        <input type="submit" value="Payer" class="btn btn-primary" />
    </div>
</form>
