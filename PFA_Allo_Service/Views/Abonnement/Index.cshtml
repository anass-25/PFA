@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}

@section styles {
}

@model List<Abonnement>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
<div class="right_col" role="main">
    <div class="">
        <div class="col-md-12 col-sm-12 ">
            <div class="x_panel">
                <div class="x_title">
                    <h2>Listes des Abonnements</h2>
                    <ul class="nav navbar-right panel_toolbox">
                        <li><a class="collapse-link"><i class="fa fa-chevron-up"></i></a></li>
                        <li class="dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false"><i class="fa fa-wrench"></i></a>
                            <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                <a class="dropdown-item" href="#">Settings 1</a>
                                <a class="dropdown-item" href="#">Settings 2</a>
                            </div>
                        </li>
                        <li><a class="close-link"><i class="fa fa-close"></i></a></li>
                    </ul>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">
                    <div id="alert-message" class="alert alert-danger" style="display:none;"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="card-box table-responsive">
                                <a class="btn btn-warning" asp-controller="Abonnement" asp-action="Create"><i class="fa-sharp fa-solid fa-plus"></i></a>
                                <table id="datatable" class="table table-striped table-bordered" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>Date Début</th>
                                            <th>Type Abonnement</th>
                                            <th>Fournisseurs</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var abonnement in Model)
                                        {
                                            <tr>
                                                <td>@abonnement.Date_Debut.ToShortDateString()</td>
                                                <td>@abonnement.Type_Abonnement</td>
                                                <td>
                                                    @if (abonnement.Fournisseurs != null && abonnement.Fournisseurs.Any())
                                                    {
                                                        <ul>
                                                            @foreach (var fournisseur in abonnement.Fournisseurs)
                                                            {
                                                                <li>@fournisseur.Nom @fournisseur.Prenom</li>
                                                            }
                                                        </ul>
                                                    }
                                                    else
                                                    {
                                                        <span>Aucun fournisseur</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (abonnement.Fournisseurs != null && abonnement.Fournisseurs.Any())
                                                    {
                                                        <button class="btn btn-warning" disabled style="opacity: 0.5;">
                                                            <i class="fas fa-edit" title="Modifier"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <a class="btn btn-warning" asp-controller="Abonnement" asp-action="Update" asp-route-id="@abonnement.AbonnementId">
                                                            <i class="fas fa-edit" title="Modifier"></i>
                                                        </a>
                                                    }
                                                    |
                                                    <button class="btn btn-danger" onclick="deleteAbonnement(@abonnement.AbonnementId)">
                                                        <i class="fas fa-trash-alt" title="Supprimer"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        function deleteAbonnement(id) {
            if (confirm('Êtes-vous sûr de vouloir supprimer cet abonnement?')) {
                $.ajax({
                    url: '@Url.Action("Delete", "Abonnement")/' + id,
                    type: 'DELETE',
                    success: function (response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            $('#alert-message').text(response.message).show();
                            setTimeout(function () {
                                $('#alert-message').hide();
                            }, 5000);
                        }
                    },
                    error: function () {
                        $('#alert-message').text('Erreur lors de la suppression de l\'abonnement.').show();
                        setTimeout(function () {
                            $('#alert-message').hide();
                        }, 5000);
                    }
                });
            }
        }
    </script>
}
